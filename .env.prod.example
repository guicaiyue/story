# 小故事铺 2.0 · 生产环境变量模板
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod   # 然后填真实值
#
# ⛔ .env.prod **绝不进 git**（.gitignore 已忽略 .env.prod / .env.prod.*，
#    并用 `!.env.prod.example` 把本模板排除在外 —— 本文件是要提交的）。
# ⛔ 本文件只有占位符，任何真实密钥都不写在这里。

# ---------------------------------------------------------------------------
# 生产数据库连接串
# ---------------------------------------------------------------------------
# 容器内按**容器名**连（生产 postgres 未发布宿主端口，08 §1.4 R7）。
# 网络是 postgres-shared，由 docker-compose.prod.yml 的 prod-db 指定。
#
# ⚠️⚠️ 关于「只读连接串」——**不能直接用只读账号**，原因见 runbook §3：
#      App 启动时就会 `POST /api/auth/register-device` 建游客账号，
#      首页/设置/进度/收藏/TTS 缓存也都是写操作。用真只读账号会全站失败。
#
# 两种口径，二选一（runbook §3 有取舍说明）：
#
#   A) 专用生产账号（**推荐**）—— 只授予 app / public 的必要权限，不用 postgres 超级用户
#      SQL 见 docs/product/13-prod-story-app-grants.sql
#      postgresql://story_app:CHANGE_ME@postgres:5432/story
#
#   B) 暂用 postgres 超级用户（内测应急）—— 权限过大，见风险 P3
#      postgresql://postgres:CHANGE_ME@postgres:5432/story
#
PROD_DATABASE_URL=postgresql://story_app:CHANGE_ME@postgres:5432/story

# ---------------------------------------------------------------------------
# 密钥（两个都必填，缺失时 compose 直接报错而不是跑起来）
# ---------------------------------------------------------------------------
# 至少 16 字符；生成：openssl rand -base64 48
PROD_JWT_SECRET=CHANGE_ME_openssl_rand_base64_48

# 🔴 禁止 123456：这是后台登录的固定验证码，弱值 = 任何人都能登录后台（08 §4.2 R5）。
#    内测阶段建议用一个长随机数字串（短信通道未接，只能靠固定码）。
PROD_FIXED_SMS_CODE=CHANGE_ME_not_123456

# ---------------------------------------------------------------------------
# 可选
# ---------------------------------------------------------------------------
PROD_LOG_LEVEL=info
PROD_TTS_VOICE=zh-CN-YunxiNeural
PROD_TTS_RATE=-10%
PROD_TTS_CHUNK_RETRIES=4
