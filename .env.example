# 小故事铺 2.0 — M1 server environment (TEMPLATE)
#
# Copy to apps/server/.env and fill in real values. Never commit .env.
#
# 03-decisions D7: production `story` is NEVER written to during development —
# it serves storynook.cn. Point these at a local/dev database only.

# Dev database. The default below matches the container created by
# `apps/server/scripts/dev-db.sh` (story-dev-postgres).
DATABASE_URL=postgresql://storydev:CHANGE_ME@story-dev-postgres:5432/story_dev

# Integration tests truncate tables, so this must be a SEPARATE database and
# must never point at production.
TEST_DATABASE_URL=postgresql://storydev:CHANGE_ME@story-dev-postgres:5432/story_test

HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Minimum 16 chars. Replace in any non-local environment.
JWT_SECRET=change-me-to-a-long-random-string

# 03-decisions D4: fixed placeholder code. No real SMS is sent in M1.
FIXED_SMS_CODE=123456

# ---------------------------------------------------------------------------
# M4: server-side TTS synthesis (03-decisions §11)
# ---------------------------------------------------------------------------
# edge-tts voice. zh-CN-YunxiNeural is a warm male Mandarin voice.
TTS_VOICE=zh-CN-YunxiNeural
# Speech rate. -10% because bedtime content should be slower than narration.
TTS_RATE=-10%
# Where synthesised MP3 files are stored. Relative paths resolve from apps/server.
# MP3 bytes stay on disk; only metadata goes into app.audio_cache.
AUDIO_CACHE_DIR=.audio-cache
# Retries per chunk when edge-tts truncates or rate-limits (503).
TTS_CHUNK_RETRIES=4
